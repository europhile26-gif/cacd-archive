# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
NODE_APP_INSTANCE=0

# Security Configuration
# Skip filesystem permission check for .env file (useful on Windows)
# Set to 'true' to bypass the 0600 permission check on startup
SKIP_STARTUP_FILESYSTEM_CHECK=false

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cacd_archive
DB_USER=cacd_user
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_LIMIT=10

# Scraping Configuration
SCRAPE_INTERVAL_MINUTES=15         # Scrape interval in minutes (default: 120)
SCRAPE_WINDOW_ENABLED=true         # Enable time-based scraping window (default: true)
SCRAPE_WINDOW_START_HOUR=8         # Scraping window start (24-hour format, default: 8 = 08:00)
SCRAPE_WINDOW_END_HOUR=18          # Scraping window end (24-hour format, default: 18 = 18:00)
SCRAPE_ON_STARTUP=false
SUMMARY_PAGE_URL=https://www.court-tribunal-hearings.service.gov.uk/summary-of-publications?locationId=109
USER_AGENT=CACD-Archive-Bot/1.0 (Educational Project)
REQUEST_TIMEOUT=10000
MAX_RETRIES=3

# Email Alert Configuration
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_RECIPIENT_DATA_ERRORS=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=CACD Archive <alerts@example.com>

# API Configuration

# Which reverse proxies are allowed to set X-Forwarded-For. request.ip is resolved by
# walking that header right-to-left and stopping at the first address NOT listed here,
# so any address not listed cannot forge a client IP. This feeds rate limiting, and will
# feed request analytics and the GeoIP blocklist (M2.2).
#   loopback          Apache/nginx on the same host (default; covers 127.0.0.1 and ::1)
#   10.0.0.0/8        proxy on another host - use its address or CIDR range
#   1.2.3.4,10.0.0.0/8  comma-separated list, e.g. proxy plus a CDN range
#   true              trust every hop - INSECURE, any client can forge its own IP
# A hop count (e.g. "1") is rejected at startup: Fastify 5 fails closed on numeric
# values, which would silently resolve request.ip to the proxy rather than the client.
TRUSTED_PROXIES=loopback

API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=900000

# Request Analytics
# Server-side only: no cookies, no browser storage, no client-side script.
# Records method + route pattern, never the query string (the hearings endpoint
# carries search terms and case numbers that must not be tied to a client address).
# Disabled by default. Do not enable in production until a privacy notice is
# published: IP addresses are personal data and the fingerprint is pseudonymous,
# not anonymous, so UK GDPR applies even without a cookie banner.
ANALYTICS_ENABLED=false
# Days to keep request records. The purge cron enforces this, and it is the
# retention period the privacy notice must state.
ANALYTICS_RETENTION_DAYS=30
# Route prefixes never logged
ANALYTICS_EXCLUDE_ROUTES=/api/v1/health,/api/docs
# Required when ANALYTICS_ENABLED=true. Salts the daily-rotating pseudo-session
# fingerprint, sha256(secret + date + ip + user agent). Without it the hash is
# reversible by brute force. Generate with: ./bin/cacd secret generate
ANALYTICS_FINGERPRINT_SECRET=
# Buffer thresholds - whichever is reached first triggers a batched write
ANALYTICS_FLUSH_INTERVAL_MS=5000
ANALYTICS_FLUSH_BATCH_SIZE=100
# When the purge runs (cron format). Instance 0 only.
ANALYTICS_PURGE_CRON=0 3 * * *
# Skip logging requests that send "DNT: 1"
ANALYTICS_RESPECT_DNT=true

# GeoIP (MaxMind GeoLite2 .mmdb files, read locally)
# Country feeds the blocklist below; ASN is what separates datacentre, VPN and
# crawler traffic from real visitors. City is deliberately not collected.
GEOIP_COUNTRY_DB_PATH=/var/lib/GeoIP/GeoLite2-Country.mmdb
GEOIP_ASN_DB_PATH=/var/lib/GeoIP/GeoLite2-ASN.mmdb
# Comma-separated ISO 3166-1 alpha-2 codes returned 403 before auth and rate
# limiting. Empty disables the blocklist entirely. Example: RU,BY,IR,KP
BLOCKED_COUNTRIES=
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend Configuration
RECORDS_PER_PAGE=50

# Authentication Configuration (v2.0+)
# REQUIRED: Generate with ./bin/cacd secret generate
JWT_SECRET=
# Optional: separate cookie signing secret (falls back to JWT_SECRET if not set)
COOKIE_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Saved Search Configuration
SAVED_SEARCH_MIN_LENGTH=3
SAVED_SEARCH_MAX_LENGTH=255
SAVED_SEARCH_MAX_PER_USER=10

# Notification Rate Limiting
NOTIFICATION_MAX_PER_WINDOW=2
NOTIFICATION_WINDOW_HOURS=12

# Public-facing URL (shown in startup logs, used for CORS origin and email links)
# Set this when behind a reverse proxy, e.g. https://cacd-archive.example.com
BASE_URL=http://localhost:3000

# Registration Settings
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_ADMIN_APPROVAL=true

# Email Templates (Authentication)
EMAIL_FROM_AUTH='CACD Archive <noreply@example.com>'
